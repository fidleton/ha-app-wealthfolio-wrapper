{
  "name": "Wealthfolio-wrapper",
  "version": "dev",
  "slug": "wealthfolio-wrapper",
  "description": "Private portfolio tracker for your personal finances.",
  "url": "https://github.com/fidleton/ha-app-wealthfolio",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "init": false,
  "ingress": true,
  "ingress_port": 8089,
  "map": [
    "ssl:ro"
  ],
  "ports": {
    "8443/tcp": 8443
  },
  "ports_description": {
    "8443/tcp": "runs Wealthfolio web interface (HTTPS)"
  },
  "panel_icon": "mdi:chart-line",
  "options": {
    "ssl_tls": {
      "certificate_file": "fullchain.pem",
      "private_key_file": "privkey.pem"
    },
    "cors": [],
    "password": ""
  },
  "schema": {
    "ssl_tls": {
      "certificate_file": "str",
      "private_key_file": "str"
    },
    "cors": ["url"],
    "password": "password",
    "secret_key": "password?",
    "log_level": "list(error|warn|info|debug|trace)?"
  }
}
