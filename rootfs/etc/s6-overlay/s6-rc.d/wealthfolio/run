#!/command/with-contenv bashio
set -e

ALL_CONFIGURED="$(bashio::jq "/var/www/localhost/htdocs/config-status.json" ".allConfigured")"
if [[ "${ALL_CONFIGURED}" != "true" ]]; then
    bashio::log.error "Wealthfolio-wrapper is not fully configured. Please check the configuration status in the web interface."
    sleep infinity
    exit 1
fi

if ! bashio::config.has_value "secret_key"; then
    secret_key="$(openssl rand -base64 32)"
    bashio::app.option "secret_key" "${secret_key}"
fi
secret_key=$(bashio::config "secret_key")
auth_password=$(bashio::config "password")
if [[ -z "${auth_password}" ]]; then
    bashio::log.error "Authentication requires a non-empty password."
    exit 1
fi
cors_origin=$(bashio::jq "/data/options.json" ".cors | join(\",\")")
if bashio::config.has_value "log_level"; then
    log_level=$(bashio::config "log_level")
else
    log_level="info"
    bashio::app.option "log_level" "${log_level}"
fi

export WF_LISTEN_ADDR="127.0.0.1:8088"
export WF_STATIC_DIR="/app/dist"
export WF_DB_PATH="/data/wealthfolio.db"
export WF_SECRET_KEY="${secret_key}"
export WF_AUTH_PASSWORD_HASH="$(printf '%s' "${auth_password}" | argon2 "$(openssl rand -hex 16)" -id -e)"
export WF_CORS_ALLOW_ORIGINS="${cors_origin}"
export RUST_LOG="${log_level}"

exec /usr/local/bin/wealthfolio-server
